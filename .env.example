# ============================================================
# BACKEND API
# ============================================================
# Base URL of the Workzen Spring Boot backend (see ../workzen-backend).
VITE_API_BASE_URL=http://localhost:8080/api

# ============================================================
# AI FEATURE MODULE — ENVIRONMENT VARIABLES
# ------------------------------------------------------------
# The chat assistant and insight cards call the real backend AI
# Gateway (/api/ai/*, see workzen-backend AiController). This
# frontend switch just shows/hides the AI UI; the actual LLM call
# only happens if the BACKEND also has WORKZEN_AI_ENABLED=true and
# a valid WORKZEN_AI_API_KEY set (see workzen-backend/README.md).
# ============================================================
VITE_AI_ENABLED=true
VITE_AI_STREAMING_ENABLED=false
VITE_AI_TEMPERATURE=0.7
VITE_AI_MAX_TOKENS=1024
VITE_AI_RATE_CHAT_PER_MIN=20
VITE_AI_RATE_REQ_PER_MIN=60
